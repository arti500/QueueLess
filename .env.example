# Copy values into your deployment environment; never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5433/queueless_db
DB_USERNAME=queueless
DB_PASSWORD=replace-with-a-strong-database-password
SERVER_PORT=8081
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-at-least-12-characters
JWT_SECRET=replace-with-base64-encoded-random-secret-of-at-least-32-bytes
JWT_TTL_SECONDS=3600
